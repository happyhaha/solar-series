---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseCard from '../components/CaseCard.astro';

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Обо мне — Рахим Муратов">
  <Hero />

  <section class="w-full px-6 md:px-12 pb-16">
    <h2
      class="font-heading text-3xl md:text-5xl font-black tracking-display mb-6 md:mb-8"
    >
      Проекты
    </h2>
    <div class="flex flex-col gap-6 md:gap-10">
      {cases.map((c) => (
        <CaseCard
          href={`/cases/${c.id}`}
          title={c.data.title}
          cover={c.data.cover}
          coverFit={c.data.coverFit}
          coverAspect={c.data.coverAspect}
          coverType={c.data.coverType}
          screens={c.data.screens}
        />
      ))}
    </div>
  </section>
</BaseLayout>
