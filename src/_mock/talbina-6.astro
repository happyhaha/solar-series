---
// ReadingStopForm 1:1 — экран после остановки сессии чтения
const lastPage = 218;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>talbina — Сессия завершена</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary: #894e58; --primary-dim: #6f3f47; --on-primary: #fff7f7;
        --primary-container: #feb2bd; --surface: #fcf9f7; --sc-lowest: #ffffff;
        --sc-low: #f6f3f1; --sc-high: #eae8e5; --on-surface: #323331;
        --on-surface-variant: #5f5f5d;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { background: var(--surface); }
      body { font-family: 'Inter', sans-serif; }
      .phone { width: 100vw; min-height: 100vh; background: var(--surface);
        color: var(--on-surface); position: relative; overflow: hidden; }
      .ms { font-family: 'Material Symbols Outlined'; line-height: 1; display: inline-block;
        vertical-align: middle; font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
      .ms.fill { font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24; }
      .main { max-width: 448px; margin: 0 auto; padding: 48px 16px 40px; }

      .hero { padding: 40px 0; text-align: center; }
      .badge-wrap { position: relative; display: inline-block; margin-bottom: 24px; }
      .circle { width: 128px; height: 128px; border-radius: 999px; margin: 0 auto;
        background: linear-gradient(45deg, var(--primary), var(--primary-container));
        display: grid; place-items: center; box-shadow: 0 1px 2px rgba(50,51,49,.06); }
      .circle .ms { color: #fff; font-size: 52px; }
      .badge { position: absolute; bottom: -8px; right: -8px; background: var(--sc-lowest);
        padding: 8px; border-radius: 12px; box-shadow: 0 4px 12px rgba(50,51,49,.12); }
      .badge .ms { color: var(--primary); font-size: 20px; }
      .hero h2 { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 28px;
        letter-spacing: -.02em; margin-bottom: 8px; }
      .hero .bt { color: var(--on-surface-variant); font-weight: 500; }
      .hero .dur { color: var(--primary); font-weight: 700; font-size: 18px; margin-top: 4px; }

      form { display: flex; flex-direction: column; gap: 24px; }
      .pcard { background: var(--sc-lowest); padding: 24px; border-radius: 12px;
        box-shadow: 0 8px 24px rgba(50,51,49,.04); }
      .pcard .r1 { display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 12px; }
      .pcard .lab { font-size: 12px; font-weight: 700; color: var(--primary);
        text-transform: uppercase; letter-spacing: .14em; }
      .pcard .were { font-size: 12px; color: var(--on-surface-variant); }
      .pwrap { position: relative; display: flex; align-items: center; }
      .pwrap input { width: 100%; background: var(--sc-low); border: 0; border-radius: 12px;
        padding: 16px 24px; font: inherit; font-size: 24px; font-weight: 700;
        color: var(--on-surface); }
      .pwrap .ic { position: absolute; right: 16px; color: rgba(95,95,93,.5); }
      .pwrap .ic .ms { font-size: 18px; }
      .cmt { display: flex; flex-direction: column; gap: 8px; }
      .cmt label { font-size: 14px; font-weight: 600; color: var(--on-surface-variant);
        margin-left: 4px; }
      .cmt textarea { width: 100%; background: var(--sc-lowest); border: 0;
        border-radius: 12px; padding: 16px; font: inherit; font-size: 15px;
        color: var(--on-surface); resize: none; line-height: 1.5; }
      .cmt textarea::placeholder { color: rgba(95,95,93,.4); }
      .submit { width: 100%; padding: 16px; border: 0; border-radius: 12px;
        background: linear-gradient(90deg, var(--primary), var(--primary-dim));
        color: var(--on-primary); font: inherit; font-weight: 700; font-size: 14px;
        text-transform: uppercase; letter-spacing: .08em;
        box-shadow: 0 14px 28px -14px rgba(137,78,88,.7); }
    </style>
  </head>
  <body>
    <div class="phone">
      <main class="main">
        <div class="hero">
          <div class="badge-wrap">
            <div class="circle"><span class="ms fill">check_circle</span></div>
            <div class="badge"><span class="ms">auto_stories</span></div>
          </div>
          <h2>Сессия завершена</h2>
          <p class="bt">Атомные привычки</p>
          <p class="dur">34 мин</p>
        </div>

        <form>
          <div class="pcard">
            <div class="r1">
              <span class="lab">На какой вы странице?</span>
              <span class="were">были на {lastPage}</span>
            </div>
            <div class="pwrap">
              <input type="number" value="240" />
              <span class="ic"><span class="ms">auto_stories</span></span>
            </div>
          </div>

          <div class="cmt">
            <label>Комментарий к сессии</label>
            <textarea rows="4">Глава про систему вместо цели — записал, чтобы вернуться. Идея про 1% улучшений каждый день звучит как сложный процент.</textarea>
          </div>

          <button type="submit" class="submit">Завершить</button>
        </form>
      </main>
    </div>
  </body>
</html>
