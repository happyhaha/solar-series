---
// ProgressPage 1:1: карточки сводки + хитмап «Последние 30 дней»
const dow = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
// 30 дней, padding под старт недели (firstDay = 2 → начинаем со среды)
const firstDay = 2;
const levels = [
  3, 0, 2, 4, 1, 0, 2, 3, 2, 0, 1, 4, 3, 2, 0,
  2, 1, 3, 4, 2, 0, 3, 2, 1, 4, 3, 0, 2, 3, 2,
];
const bg = [
  'var(--sc-low)',
  'color-mix(in srgb, var(--primary) 15%, transparent)',
  'color-mix(in srgb, var(--primary) 30%, transparent)',
  'color-mix(in srgb, var(--primary) 55%, transparent)',
  'color-mix(in srgb, var(--primary) 80%, transparent)',
];
const fg = ['var(--on-surface-variant)', 'var(--primary)', 'var(--primary)', 'var(--primary)', '#fff'];
const cells = [...Array(firstDay).fill(null), ...levels.map((lvl, i) => ({ lvl, num: i + 17 }))];
const todayIdx = cells.length - 1;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>talbina — Прогресс</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary: #894e58; --on-primary: #fff7f7; --primary-container: #feb2bd;
        --surface: #fcf9f7; --sc-lowest: #ffffff; --sc-low: #f6f3f1;
        --sc-high: #eae8e5; --on-surface: #323331; --on-surface-variant: #5f5f5d;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { background: var(--surface); }
      body { font-family: 'Inter', sans-serif; }
      .phone { width: 100vw; height: 100vh; background: var(--surface);
        color: var(--on-surface); position: relative; overflow: hidden; }
      .ms { font-family: 'Material Symbols Outlined'; line-height: 1; display: inline-block;
        vertical-align: middle; font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
      .ms.fill { font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24; }
      .appbar { position: absolute; top: 0; left: 0; right: 0; height: 56px;
        display: flex; align-items: center; justify-content: space-between; padding: 0 16px;
        background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 8px 24px rgba(50,51,49,.04); z-index: 50; }
      .appbar .logo { display: flex; align-items: center; gap: 8px; }
      .appbar .logo .ms { color: var(--primary); font-size: 24px; }
      .appbar .logo h1 { font-family: 'Montserrat', sans-serif; font-weight: 700;
        font-size: 20px; color: var(--primary); text-transform: lowercase; }
      .appbar .out { color: rgba(50,51,49,.6); font-size: 22px; }
      .main { position: absolute; top: 56px; bottom: 64px; left: 0; right: 0;
        overflow: hidden; padding: 24px 16px 0; }
      .h2 { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 24px;
        margin-bottom: 24px; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
      .card { padding: 16px; background: var(--sc-lowest);
        border: 1px solid rgba(179,178,175,.15); border-radius: 12px; }
      .card .k { font-size: 10px; font-weight: 700; color: var(--on-surface-variant);
        text-transform: uppercase; letter-spacing: .14em; margin-bottom: 4px; }
      .card .v { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 20px; }
      .card .v.pri { color: var(--primary); }
      .card .s { font-size: 12px; color: var(--on-surface-variant); margin-top: 2px; }
      .lbl { font-size: 10px; font-weight: 700; color: var(--on-surface-variant);
        text-transform: uppercase; letter-spacing: .14em; margin-bottom: 12px; }
      .dow { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px; }
      .dow div { text-align: center; font-size: 9px; font-weight: 700;
        color: var(--on-surface-variant); text-transform: uppercase; letter-spacing: .08em; }
      .cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
      .cell { aspect-ratio: 1; border-radius: 8px; display: flex; align-items: center;
        justify-content: center; font-size: 11px; font-weight: 500; }
      .cell.today { box-shadow: 0 0 0 2px var(--primary), 0 0 0 4px var(--surface); }
      .legend { display: flex; align-items: center; justify-content: flex-end; gap: 6px;
        margin-top: 8px; }
      .legend span { font-size: 9px; color: var(--on-surface-variant); }
      .legend i { width: 12px; height: 12px; border-radius: 4px; display: block; }
      .nav { position: absolute; bottom: 0; left: 0; right: 0; height: 64px;
        display: flex; justify-content: space-around; align-items: center; padding: 0 16px;
        background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 -4px 24px rgba(50,51,49,.04); border-radius: 12px 12px 0 0; z-index: 50; }
      .nav a { display: flex; flex-direction: column; align-items: center; gap: 2px;
        padding: 4px 12px; border-radius: 12px; color: rgba(50,51,49,.5);
        text-decoration: none; }
      .nav a.on { background: rgba(254,178,189,.2); color: var(--primary); }
      .nav a .ms { font-size: 24px; }
      .nav a span { font-size: 10px; text-transform: uppercase; letter-spacing: .06em;
        margin-top: 2px; }
    </style>
  </head>
  <body>
    <div class="phone">
      <div class="appbar">
        <div class="logo"><span class="ms fill">spa</span><h1>talbina</h1></div>
        <span class="ms out">logout</span>
      </div>

      <div class="main">
        <h2 class="h2">Прогресс</h2>

        <section class="grid">
          <div class="card">
            <p class="k">За неделю</p>
            <p class="v pri">4ч 12м</p>
            <p class="s">182 стр</p>
          </div>
          <div class="card">
            <p class="k">За месяц</p>
            <p class="v pri">18ч 40м</p>
            <p class="s">736 стр</p>
          </div>
          <div class="card">
            <p class="k">Дочитано</p>
            <p class="v">2</p>
            <p class="s">за месяц</p>
          </div>
          <div class="card">
            <p class="k">Подряд</p>
            <p class="v">🔥 12</p>
            <p class="s">дней</p>
          </div>
        </section>

        <section>
          <p class="lbl">Последние 30 дней</p>
          <div class="dow">{dow.map((d) => <div>{d}</div>)}</div>
          <div class="cal">
            {cells.map((c, i) =>
              c === null ? (
                <div></div>
              ) : (
                <div
                  class:list={['cell', i === todayIdx ? 'today' : '']}
                  style={`background:${bg[c.lvl]};color:${fg[c.lvl]};opacity:${c.lvl === 0 ? 0.5 : 1}`}
                >
                  {c.num}
                </div>
              ),
            )}
          </div>
          <div class="legend">
            <span>Меньше</span>
            {bg.map((b, i) => (
              <i style={`background:${b};opacity:${i === 0 ? 0.5 : 1}`}></i>
            ))}
            <span>Больше</span>
          </div>
        </section>
      </div>

      <nav class="nav">
        <a><span class="ms">auto_stories</span><span>Читаю</span></a>
        <a><span class="ms">library_books</span><span>Прочитано</span></a>
        <a class="on"><span class="ms fill">trending_up</span><span>Прогресс</span></a>
        <a><span class="ms">person</span><span>Профиль</span></a>
      </nav>
    </div>
  </body>
</html>
