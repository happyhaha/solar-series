---
import BrowserFrame from './BrowserFrame.astro';

interface Props {
  src: string;
  alt: string;
  url?: string;
  aspect?: string;
  fit?: 'cover' | 'contain';
  loading?: 'lazy' | 'eager';
}
const { src, alt, url, aspect = '16 / 9', fit = 'cover', loading = 'eager' } = Astro.props;
---

<div class="pair not-prose bg-gray-100 rounded-lg">
  <div class="pair-shot">
    <BrowserFrame src={src} alt={alt} url={url} aspect={aspect} fit={fit} loading={loading} />
  </div>
  <div class="pair-text">
    <slot />
  </div>
</div>

<style>
  /* Выходим из max-w-2xl у Prose: на всю ширину секции (body overflow-x-clip) */
  .pair {
    margin: 0 0 3rem;
    width: calc(100vw - 3rem);
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }
  .pair-shot { width: 100%; flex: none; }
  .pair-text { font-size: 1.25rem; line-height: 1.5; color: var(--ink); }
  .pair-text :global(p) { margin: 0; }

  @media (min-width: 768px) {
    .pair {
      width: calc(100vw - 6rem);
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 4rem;
      padding: 3.5rem 3rem;
      margin: 0 0 3.5rem;
    }
    .pair-shot { width: 58%; max-width: 620px; }
    .pair-text { flex: 1; max-width: 32rem; font-size: 1.5rem; }
  }
</style>
