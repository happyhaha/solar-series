---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Страница не найдена — Рахим Муратов">
  <section class="w-full px-6 md:px-12 pt-20 pb-20 md:pt-32 md:pb-32">
    <p class="font-heading text-7xl md:text-9xl font-black tracking-display text-muted/30 leading-none">
      404
    </p>
    <h1 class="font-heading text-3xl md:text-5xl font-bold leading-tight tracking-display mt-4">
      Страница не найдена
    </h1>
    <p class="text-base md:text-lg text-text mt-4 max-w-xl">
      Такой страницы нет или её перенесли. Можно вернуться на главную и посмотреть кейсы.
    </p>
    <a
      href="/"
      class="inline-block mt-6 text-accent underline underline-offset-4 decoration-[0.5px] decoration-accent/25 hover:text-accent-hover hover:decoration-accent-hover/40 transition-colors"
    >← На главную</a>
  </section>
</BaseLayout>
