---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import Prose from '../../components/Prose.astro';
import DeviceMockup from '../../components/DeviceMockup.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases', ({ data }) => !data.draft);
  const sorted = cases.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Рахим Муратов`}>
  <CaseHeader
    title={entry.data.title}
    titleLines={entry.data.titleLines}
    brand={entry.data.brand}
    subtitle={entry.data.subtitle}
    summary={entry.data.summaryInHeader ? entry.data.summary : undefined}
    cover={entry.data.coverInHeader ? entry.data.cover : undefined}
    coverUrl={entry.data.links?.live}
    coverFit={entry.data.coverFit}
    coverAspect={entry.data.coverAspect}
  />

  {entry.data.heroImage && (
    <img
      src={entry.data.heroImage}
      alt={entry.data.title}
      class="block w-full"
    />
  )}

  <section class="w-full px-6 md:px-12 pb-20">
    <Prose>
      <Content />
    </Prose>

    {entry.data.gallery && entry.data.gallery.length > 0 && (
      <div class="mt-12 md:mt-16">
        <DeviceMockup alt={entry.data.title} screens={entry.data.gallery} />
      </div>
    )}
  </section>
</BaseLayout>
