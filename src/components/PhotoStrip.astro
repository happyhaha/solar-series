---
interface Photo {
  src: string;
  alt: string;
}
interface Props {
  big: Photo;
  small: [Photo, Photo];
  loading?: 'lazy' | 'eager';
}
const { big, small, loading = 'lazy' } = Astro.props;
---

<div class="strip not-prose">
  <figure class="strip__big">
    <img src={big.src} alt={big.alt} loading={loading} />
  </figure>
  <div class="strip__small">
    {small.map((p) => (
      <figure>
        <img src={p.src} alt={p.alt} loading={loading} />
      </figure>
    ))}
  </div>
</div>

<style>
  /* Выходим из max-w-2xl у Prose: на всю ширину секции
     (контейнер кейса = w-full px-6 md:px-12, у body overflow-x-clip). */
  .strip {
    margin: 3rem 0;
    width: calc(100vw - 3rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .strip figure { margin: 0; }
  .strip img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.75rem;
  }
  .strip__big {
    aspect-ratio: 4 / 3;
  }
  .strip__small {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .strip__small figure { aspect-ratio: 4 / 3; }

  @media (min-width: 768px) {
    .strip {
      width: calc(100vw - 6rem);
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1rem;
      align-items: stretch;
    }
    .strip__big { aspect-ratio: auto; }
    .strip__small {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .strip__small figure { aspect-ratio: auto; }
  }
</style>
