---
interface Photo {
  src: string;
  alt: string;
}
interface Props {
  photos: [Photo, Photo];
  loading?: 'lazy' | 'eager';
}
const { photos, loading = 'lazy' } = Astro.props;
---

<div class="pairgrid not-prose">
  {photos.map((p) => (
    <figure>
      <img src={p.src} alt={p.alt} loading={loading} />
    </figure>
  ))}
</div>

<style>
  /* Выходим из max-w-2xl у Prose: на всю ширину секции
     (контейнер кейса = w-full px-6 md:px-12, у body overflow-x-clip). */
  .pairgrid {
    margin: 3rem 0;
    width: calc(100vw - 3rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .pairgrid figure {
    margin: 0;
    aspect-ratio: 4 / 3;
  }
  .pairgrid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 768px) {
    .pairgrid {
      width: calc(100vw - 6rem);
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
