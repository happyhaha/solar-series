---
const groups = [
  {
    key: 'Май 2025',
    books: [
      { title: 'Атомные привычки', author: 'Джеймс Клир', rating: 9,
        cover: 'https://s.f.kz/prod/3353/3352469_1000.jpg' },
      { title: 'Поток', author: 'Михай Чиксентмихайи', rating: 8,
        cover: 'https://www.hse.ru/pubs/share/direct/792169181.jpg:r1118x745.jpg' },
    ],
  },
  {
    key: 'Апрель 2025',
    books: [
      { title: 'Краткая история времени', author: 'Стивен Хокинг', rating: 10,
        cover: 'https://simg.marwin.kz/media/catalog/product/cache/41deb699a7fea062a8915debbbb0442c/c/o/cover1__w600_135_300.jpg' },
      { title: 'Поправка 22', author: 'Джозеф Хеллер', rating: 7,
        cover: 'https://simg.marwin.kz/media/catalog/product/cache/41deb699a7fea062a8915debbbb0442c/migrated/article/16731/62_tn3.jpg' },
      { title: 'Мартин Иден', author: 'Джек Лондон', rating: 9,
        cover: 'https://simg.marwin.kz/media/catalog/product/cache/41deb699a7fea062a8915debbbb0442c/c/o/cover1__w600_134_514.jpg' },
    ],
  },
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>talbina — Прочитано</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary: #894e58; --on-primary: #fff7f7; --primary-container: #feb2bd;
        --surface: #fcf9f7; --sc-lowest: #ffffff; --sc-low: #f6f3f1;
        --sc-high: #eae8e5; --on-surface: #323331; --on-surface-variant: #5f5f5d;
        --outline-variant: #b3b2af;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { background: var(--surface); }
      body { font-family: 'Inter', sans-serif; }
      .phone { width: 100vw; height: 100vh; background: var(--surface);
        color: var(--on-surface); position: relative; overflow: hidden; }
      .ms { font-family: 'Material Symbols Outlined'; font-weight: normal;
        font-style: normal; line-height: 1; display: inline-block; vertical-align: middle;
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
      .ms.fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

      .appbar { position: absolute; top: 0; left: 0; right: 0; height: 56px;
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 16px; background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 8px 24px rgba(50,51,49,.04); z-index: 50; }
      .appbar .logo { display: flex; align-items: center; gap: 8px; }
      .appbar .logo .ms { color: var(--primary); font-size: 24px; }
      .appbar .logo h1 { font-family: 'Montserrat', sans-serif; font-weight: 700;
        font-size: 20px; color: var(--primary); text-transform: lowercase;
        letter-spacing: -.02em; }
      .appbar .out { color: rgba(50,51,49,.6); font-size: 22px; }

      .main { position: absolute; top: 56px; bottom: 64px; left: 0; right: 0;
        overflow: hidden; padding: 24px 16px 0; }
      .head { display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 24px; }
      .head h2 { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 24px; }
      .head .addbtn { display: flex; align-items: center; gap: 6px; padding: 6px 12px;
        border-radius: 8px; background: rgba(254,178,189,.2); color: var(--primary);
        font: inherit; font-size: 14px; font-weight: 600; border: 0; cursor: pointer; }
      .head .addbtn .ms { font-size: 16px; }

      .group { margin-bottom: 22px; }
      .group .gk { font-size: 11px; font-weight: 700; color: var(--on-surface-variant);
        text-transform: uppercase; letter-spacing: .16em; padding: 0 4px;
        display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
      .group .gk .sh { color: var(--primary); font-size: 16px; }

      .bcard { width: 100%; display: flex; align-items: center; gap: 12px; padding: 12px;
        background: var(--sc-lowest); border-radius: 12px;
        border: 1px solid rgba(179,178,175,.15); margin-bottom: 8px; text-align: left; }
      .bcard .cover { width: 40px; height: 56px; border-radius: 8px; flex-shrink: 0;
        overflow: hidden; background: var(--sc-high);
        box-shadow: 0 4px 10px -5px rgba(50,51,49,.5); }
      .bcard .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .bcard .info { flex: 1; min-width: 0; }
      .bcard .info .t { font-weight: 600; font-size: 14px; line-height: 1.3; }
      .bcard .info .a { font-size: 12px; color: var(--on-surface-variant); margin-top: 2px; }
      .bcard .info .r { font-size: 11px; color: var(--on-surface-variant);
        font-weight: 500; margin-top: 4px; }
      .bcard .chev { color: rgba(50,51,49,.3); font-size: 18px; flex-shrink: 0; }

      .nav { position: absolute; bottom: 0; left: 0; right: 0; height: 64px;
        display: flex; justify-content: space-around; align-items: center;
        padding: 0 16px; background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 -4px 24px rgba(50,51,49,.04); border-radius: 12px 12px 0 0; z-index: 50; }
      .nav a { display: flex; flex-direction: column; align-items: center;
        gap: 2px; padding: 4px 12px; border-radius: 12px;
        color: rgba(50,51,49,.5); text-decoration: none; }
      .nav a.on { background: rgba(254,178,189,.2); color: var(--primary); }
      .nav a .ms { font-size: 24px; }
      .nav a span { font-size: 10px; text-transform: uppercase; letter-spacing: .06em;
        margin-top: 2px; }
    </style>
  </head>
  <body>
    <div class="phone">
      <div class="appbar">
        <div class="logo">
          <span class="ms fill">spa</span>
          <h1>talbina</h1>
        </div>
        <span class="ms out">logout</span>
      </div>

      <div class="main">
        <div class="head">
          <h2>Прочитано</h2>
          <button class="addbtn"><span class="ms">add</span>Добавить</button>
        </div>

        {groups.map((g) => (
          <div class="group">
            <div class="gk">
              <span>{g.key}</span>
              <span class="ms sh">share</span>
            </div>
            {g.books.map((b) => (
              <div class="bcard">
                <div class="cover"><img src={b.cover} alt={b.title} /></div>
                <div class="info">
                  <p class="t">{b.title}</p>
                  <p class="a">{b.author}</p>
                  <p class="r">{b.rating}/10</p>
                </div>
                <span class="ms chev">chevron_right</span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <nav class="nav">
        <a><span class="ms">auto_stories</span><span>Читаю</span></a>
        <a class="on"><span class="ms fill">library_books</span><span>Прочитано</span></a>
        <a><span class="ms">trending_up</span><span>Прогресс</span></a>
        <a><span class="ms">person</span><span>Профиль</span></a>
      </nav>
    </div>
  </body>
</html>
