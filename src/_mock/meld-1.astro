---
const cats = [
  { emo: '🛒', name: 'продукты', n: 14, sum: 142_300 },
  { emo: '🍽', name: 'кафе', n: 9, sum: 86_500 },
  { emo: '🚕', name: 'транспорт', n: 11, sum: 48_200 },
  { emo: '🏠', name: 'дом и связь', n: 4, sum: 64_900 },
];
const days = [
  {
    label: 'сегодня',
    tx: [
      { emo: '🛒', title: 'Magnum', note: 'продукты на неделю', amount: -12_480 },
      { emo: '☕', title: 'Coffee Boom', note: '', amount: -1_900 },
    ],
  },
  {
    label: 'вчера',
    tx: [
      { emo: '💸', title: 'Зарплата', note: 'аванс', amount: 620_000 },
      { emo: '🚕', title: 'Yandex Go', note: 'аэропорт', amount: -3_240 },
      { emo: '📱', title: 'Activ', note: '', amount: -4_990 },
    ],
  },
];
const money = (n: number) =>
  (n < 0 ? '−' : '+') + Math.abs(n).toLocaleString('ru-RU') + ' ₸';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Meld</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,350;0,9..144,400;1,9..144,400&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #fbf8f2; --ink: #1a1917; --ink-muted: #6e6a62; --ink-faint: #b1aba0;
        --paper: #f3eee5; --hair: rgba(26,25,23,.09); --hair-strong: rgba(26,25,23,.16);
        --expense: #a6432a; --income: #2f6b3b; --fab-bg: #1a1917; --fab-fg: #fbf8f2;
        --font-sans: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif;
        --font-serif: 'Fraunces', Georgia, serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { background: var(--bg); }
      body { font-family: var(--font-sans); }
      .phone { width: 100vw; min-height: 100vh; background: var(--bg); color: var(--ink);
        font-size: 17px; line-height: 1.45; position: relative; overflow: hidden; }

      .masthead { display: flex; align-items: center; justify-content: space-between;
        padding: 28px 20px 12px; }
      .issue { display: flex; flex-direction: column; gap: 2px; }
      .issue .month { font-family: var(--font-serif); font-style: italic; font-size: 19px;
        color: var(--ink); }
      .issue .month .ch { font-size: 11px; opacity: .55; margin-left: 4px; }
      .gear { width: 32px; height: 32px; color: var(--ink-muted); }

      .hero { padding: 14px 20px 8px; }
      .hero .today { font-family: var(--font-serif); font-style: italic; font-size: 13px;
        color: var(--ink-muted); }
      .hero .balance { font-family: var(--font-serif); font-weight: 350;
        font-size: 80px; line-height: 1.02; letter-spacing: -.02em; margin-top: 6px; }
      .hero .balance .u { font-size: 34px; color: var(--ink-muted); }
      .meta { padding: 10px 20px 0; font-family: var(--font-serif); font-style: italic;
        font-size: 15px; color: var(--ink-muted); }
      .meta .e { color: var(--expense); }
      .meta .i { color: var(--income); }

      .sec { font-family: var(--font-serif); font-style: italic; font-size: 15px;
        color: var(--ink-muted); padding: 26px 20px 8px; }
      .cat-list, .day-list { list-style: none; padding: 0 20px; }
      .row { display: grid; grid-template-columns: 28px 1fr auto; align-items: center;
        gap: 12px; padding: 12px 0; border-top: 1px dashed var(--hair-strong); }
      .row .emo { font-size: 18px; }
      .row .name { display: flex; flex-direction: column; }
      .row .name .t { font-size: 15px; }
      .row .name .s { font-size: 11.5px; color: var(--ink-faint); margin-top: 2px; }
      .row .amount { font-size: 15px; font-variant-numeric: tabular-nums; }
      .row .amount.e { color: var(--expense); }
      .row .amount.i { color: var(--income); }

      .day-head { font-family: var(--font-serif); font-style: italic; font-size: 13px;
        color: var(--ink-muted); padding: 22px 20px 4px; }

      .fab { position: fixed; right: 20px; bottom: 28px; width: 56px; height: 56px;
        border-radius: 9999px; background: var(--fab-bg); color: var(--fab-fg);
        display: grid; place-items: center;
        box-shadow: 0 10px 24px -8px rgba(26,25,23,.35), 0 2px 6px -2px rgba(26,25,23,.2); }
    </style>
  </head>
  <body>
    <div class="phone">
      <div class="masthead">
        <div class="issue">
          <span class="month">май <span class="ch">▾</span></span>
        </div>
        <svg class="gear" viewBox="0 0 24 24" width="22" height="22" fill="none"
          stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </div>

      <div class="hero">
        <div class="today">вторник, 16 мая</div>
        <div class="balance">248 600<span class="u"> ₸</span></div>
      </div>
      <div class="meta">
        ушло <span class="e">375 300 ₸</span> · пришло <span class="i">620 000 ₸</span>
      </div>

      <div class="sec">категории</div>
      <ul class="cat-list">
        {cats.map((c) => (
          <li class="row">
            <span class="emo">{c.emo}</span>
            <span class="name">
              <span class="t">{c.name}</span>
              <span class="s">{c.n} операций</span>
            </span>
            <span class="amount e">{c.sum.toLocaleString('ru-RU')} ₸</span>
          </li>
        ))}
      </ul>

      {days.map((d) => (
        <>
          <div class="day-head">{d.label}</div>
          <ul class="day-list">
            {d.tx.map((t) => (
              <li class="row">
                <span class="emo">{t.emo}</span>
                <span class="name">
                  <span class="t">{t.title}</span>
                  {t.note && <span class="s">{t.note}</span>}
                </span>
                <span class:list={['amount', t.amount < 0 ? 'e' : 'i']}>
                  {money(t.amount)}
                </span>
              </li>
            ))}
          </ul>
        </>
      ))}

      <div class="fab">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
      </div>
    </div>
  </body>
</html>
