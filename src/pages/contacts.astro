---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Контакты — Рахим Муратов">
  <section class="w-full px-6 md:px-12 pt-16 pb-12 md:pt-24">
    <h1 class="font-heading text-3xl md:text-5xl font-bold leading-tight tracking-display">
      Контакты
    </h1>
  </section>

  <section class="w-full px-6 md:px-12 pb-16 flex flex-col gap-10 md:flex-row md:items-start md:gap-12 max-w-5xl">
    <img
      src="/img/rahim_portrait2.jpg"
      alt="Рахим Муратов"
      class="w-40 h-40 md:w-56 md:h-56 object-cover rounded-full shrink-0"
    />

    <div class="flex flex-col gap-6">
      <p class="text-lg md:text-xl text-gray-700 leading-snug">
        Рахим Муратов. Веб-разработчик. Беру проекты на бэкенд (PHP, Laravel),
        провожу консультации, веду канал на YouTube.
      </p>

      <div>
        <p class="text-sm uppercase tracking-widest text-gray-500 mb-3">Связаться</p>
        <ul class="flex flex-col gap-2 text-lg">
          <li><a href="https://t.me/rahim_muratov" target="_blank" rel="noopener" class="text-accent underline underline-offset-4 decoration-[0.5px] decoration-accent/25 hover:text-accent-hover hover:decoration-accent-hover/40 transition-colors">Telegram</a></li>
          <li><a href="mailto:forbdruid@gmail.com" class="text-accent underline underline-offset-4 decoration-[0.5px] decoration-accent/25 hover:text-accent-hover hover:decoration-accent-hover/40 transition-colors">forbdruid@gmail.com</a></li>
          <li><a href="https://youtube.com/user/tobecloser007" target="_blank" rel="noopener" class="text-accent underline underline-offset-4 decoration-[0.5px] decoration-accent/25 hover:text-accent-hover hover:decoration-accent-hover/40 transition-colors">YouTube</a></li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>
