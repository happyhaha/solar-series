---
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, loading = 'lazy' } = Astro.props;
---

<div class="split">
  <div class="split-shot not-prose">
    <div class="device">
      <div class="device__frame">
        <span class="device__btn device__btn--silent"></span>
        <span class="device__btn device__btn--vol device__btn--vol1"></span>
        <span class="device__btn device__btn--vol device__btn--vol2"></span>
        <span class="device__btn device__btn--power"></span>
        <div class="device__screen">
          <img src={src} alt={alt} loading={loading} class="device__img" />
          <span class="device__island"></span>
        </div>
      </div>
    </div>
  </div>
  <div class="split-text">
    <slot />
  </div>
</div>

<style>
  /* Выходим из max-w-2xl у Prose: занимаем всю ширину секции
     (контейнер кейса = w-full px-6 md:px-12, у body overflow-x-clip). */
  .split {
    margin: 1.25rem 0 2.5rem;
    width: calc(100vw - 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Мобила: текст-описание идёт первым, мокап вторым */
  .split-text { order: -1; }
  .split-shot { order: 0; }

  /* Каркас айфона (источник: DeviceMockup.astro); cqw-юниты тянутся к ширине колонки */
  .device { container-type: inline-size; width: 100%; }
  .device__frame {
    position: relative;
    border-radius: 16cqw;
    padding: 3.4cqw;
    background:
      linear-gradient(150deg, #3a3a3d 0%, #1c1c1e 28%, #2c2c2e 55%, #161617 100%);
    box-shadow:
      0 24px 48px -20px rgba(0, 0, 0, 0.55),
      0 4px 12px -4px rgba(0, 0, 0, 0.35),
      inset 0 0 0 0.4cqw rgba(255, 255, 255, 0.06);
  }
  .device__screen {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 12cqw;
    background: #000;
    font-size: 0;
  }
  .device__img { display: block; width: 100%; height: auto; margin: 0; }
  .device__island {
    position: absolute;
    top: 2.6cqw;
    left: 50%;
    transform: translateX(-50%);
    width: 30cqw;
    height: 8cqw;
    background: #000;
    border-radius: 999px;
    z-index: 2;
  }
  .device__btn {
    position: absolute;
    background: linear-gradient(90deg, #1a1a1c, #404043, #1a1a1c);
    z-index: 1;
  }
  .device__btn--silent {
    left: -0.5cqw;
    top: 19cqw;
    width: 0.9cqw;
    height: 5cqw;
    border-radius: 2px 0 0 2px;
  }
  .device__btn--vol {
    left: -0.7cqw;
    width: 1cqw;
    height: 9cqw;
    border-radius: 2px 0 0 2px;
  }
  .device__btn--vol1 { top: 28cqw; }
  .device__btn--vol2 { top: 40cqw; }
  .device__btn--power {
    right: -0.7cqw;
    top: 32cqw;
    width: 1cqw;
    height: 14cqw;
    border-radius: 0 2px 2px 0;
  }

  @media (min-width: 768px) {
    .split {
      margin: 3rem 0;
      width: calc(100vw - 6rem);
      display: grid;
      grid-template-columns: minmax(300px, 380px) 1fr;
      gap: 3.5rem;
      align-items: center;
    }
    .split-shot { order: 0; }
    .split-text { order: 1; }
    .split-text :global(p:first-child) { margin-top: 0; }
    .split-text :global(p:last-child) { margin-bottom: 0; }
  }
</style>
