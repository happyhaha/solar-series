---
import BrowserFrame from './BrowserFrame.astro';

interface Props {
  title: string;
  titleLines?: string[];
  brand?: string;
  subtitle?: string;
  summary?: string;
  cover?: string;
  coverUrl?: string;
  coverFit?: 'cover' | 'contain';
  coverAspect?: string;
}

const { title, titleLines, brand = 'марлиндев.ру', subtitle, summary, cover, coverUrl, coverFit = 'cover', coverAspect } = Astro.props;
const lines = titleLines && titleLines.length > 0 ? titleLines : [title];
---

<section class="w-full px-6 md:px-12 pt-10 md:pt-14 pb-10 md:pb-14">
  <a
    href="/"
    class="text-xs text-accent hover:text-accent-hover transition-colors"
  >← Все кейсы</a>

  <div class="flex flex-col gap-3 mt-6">
    {brand && brand !== 'марлиндев.ру' && (
      <span
        class="font-heading text-sm md:text-base text-gray-500 tracking-display w-fit"
      >
        {brand}
      </span>
    )}

    {subtitle && (
      <p
        class="font-heading text-xs md:text-sm text-gray-900 leading-tight tracking-display"
      >
        {subtitle}
      </p>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 md:items-baseline mt-4 md:mt-6">
    <h1
      class="font-heading text-3xl md:text-5xl font-black leading-display tracking-display"
    >
      {lines.map((line, i) => (
        <>{i > 0 && <br />}{line}</>
      ))}
    </h1>

    {summary && (
      <p class="text-lg md:text-xl text-gray-900 leading-snug">
        {summary}
      </p>
    )}
  </div>
</section>

{cover && (
  <div class="w-full px-6 md:px-12 mb-8 md:mb-12">
    <BrowserFrame src={cover} alt={title} url={coverUrl} fit={coverFit} aspect={coverAspect} />
  </div>
)}
