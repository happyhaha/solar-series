---
// ProfilePage 1:1 (заголовок «Настройки»): карта юзера, тема-тумблер, выход
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>talbina — Настройки</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary: #894e58; --on-primary: #fff7f7; --primary-container: #feb2bd;
        --surface: #fcf9f7; --sc-lowest: #ffffff; --sc-low: #f6f3f1;
        --sc-high: #eae8e5; --on-surface: #323331; --on-surface-variant: #5f5f5d;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { background: var(--surface); }
      body { font-family: 'Inter', sans-serif; }
      .phone { width: 100vw; height: 100vh; background: var(--surface);
        color: var(--on-surface); position: relative; overflow: hidden; }
      .ms { font-family: 'Material Symbols Outlined'; line-height: 1; display: inline-block;
        vertical-align: middle; font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
      .ms.fill { font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24; }
      .appbar { position: absolute; top: 0; left: 0; right: 0; height: 56px;
        display: flex; align-items: center; justify-content: space-between; padding: 0 16px;
        background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 8px 24px rgba(50,51,49,.04); z-index: 50; }
      .appbar .logo { display: flex; align-items: center; gap: 8px; }
      .appbar .logo .ms { color: var(--primary); font-size: 24px; }
      .appbar .logo h1 { font-family: 'Montserrat', sans-serif; font-weight: 700;
        font-size: 20px; color: var(--primary); text-transform: lowercase; }
      .appbar .out { color: rgba(50,51,49,.6); font-size: 22px; }
      .main { position: absolute; top: 56px; bottom: 64px; left: 0; right: 0;
        overflow: hidden; padding: 24px 16px 0; }
      .h2 { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 24px;
        margin-bottom: 24px; }
      .card { background: var(--sc-lowest); border: 1px solid rgba(179,178,175,.15);
        border-radius: 12px; padding: 20px; margin-bottom: 24px; }
      .uinfo { display: flex; align-items: center; gap: 16px; }
      .uinfo .ic { width: 48px; height: 48px; border-radius: 12px;
        background: rgba(137,78,88,.1); display: grid; place-items: center; }
      .uinfo .ic .ms { color: var(--primary); font-size: 24px; }
      .uinfo .em { font-weight: 600; font-size: 15px; }
      .theme { display: flex; align-items: center; justify-content: space-between; }
      .theme .l { display: flex; align-items: center; gap: 16px; }
      .theme .box { width: 40px; height: 40px; border-radius: 12px;
        background: var(--sc-high); display: grid; place-items: center; }
      .theme .box .ms { color: var(--on-surface-variant); font-size: 22px; }
      .theme .t { font-weight: 600; font-size: 15px; }
      .theme .s { font-size: 12px; color: var(--on-surface-variant); margin-top: 2px; }
      .sw { width: 48px; height: 28px; border-radius: 999px; background: var(--sc-high);
        position: relative; flex-shrink: 0; }
      .sw i { position: absolute; top: 4px; left: 4px; width: 20px; height: 20px;
        border-radius: 999px; background: var(--sc-lowest);
        box-shadow: 0 1px 3px rgba(0,0,0,.2); }
      .logout { width: 100%; padding: 16px; border: 0; border-radius: 12px;
        background: var(--sc-high); color: var(--on-surface-variant); font: inherit;
        font-weight: 600; font-size: 15px; }
      .nav { position: absolute; bottom: 0; left: 0; right: 0; height: 64px;
        display: flex; justify-content: space-around; align-items: center; padding: 0 16px;
        background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 -4px 24px rgba(50,51,49,.04); border-radius: 12px 12px 0 0; z-index: 50; }
      .nav a { display: flex; flex-direction: column; align-items: center; gap: 2px;
        padding: 4px 12px; border-radius: 12px; color: rgba(50,51,49,.5);
        text-decoration: none; }
      .nav a.on { background: rgba(254,178,189,.2); color: var(--primary); }
      .nav a .ms { font-size: 24px; }
      .nav a span { font-size: 10px; text-transform: uppercase; letter-spacing: .06em;
        margin-top: 2px; }
    </style>
  </head>
  <body>
    <div class="phone">
      <div class="appbar">
        <div class="logo"><span class="ms fill">spa</span><h1>talbina</h1></div>
        <span class="ms out">logout</span>
      </div>

      <div class="main">
        <h2 class="h2">Настройки</h2>

        <div class="card">
          <div class="uinfo">
            <div class="ic"><span class="ms">person</span></div>
            <div class="em">rahim@marlindev.ru</div>
          </div>
        </div>

        <div class="card">
          <div class="theme">
            <div class="l">
              <div class="box"><span class="ms">light_mode</span></div>
              <div>
                <div class="t">Тема</div>
                <div class="s">Светлая</div>
              </div>
            </div>
            <div class="sw"><i></i></div>
          </div>
        </div>

        <button class="logout">Выйти из аккаунта</button>
      </div>

      <nav class="nav">
        <a><span class="ms">auto_stories</span><span>Читаю</span></a>
        <a><span class="ms">library_books</span><span>Прочитано</span></a>
        <a><span class="ms">trending_up</span><span>Прогресс</span></a>
        <a class="on"><span class="ms fill">person</span><span>Профиль</span></a>
      </nav>
    </div>
  </body>
</html>
