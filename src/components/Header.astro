---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Менторство' },
  { href: '/consultation', label: 'Консультация' },
  { href: '/about', label: 'Обо мне' },
];
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="w-full px-6 md:px-12 py-4 border-b border-border">
  <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 md:gap-x-8 text-sm md:text-base">
    <a href="/" class="mr-auto shrink-0" aria-label="Рахим Муратов — на главную">
      <img src="/img/rahim_portrait2_black.png" alt="Рахим Муратов" class="w-7 h-auto" />
    </a>
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={isActive(l.href) ? 'page' : undefined}
        class:list={[
          'transition-colors hover:text-accent',
          isActive(l.href) ? 'text-text font-bold' : 'text-muted',
        ]}
      >{l.label}</a>
    ))}

    <button
      id="theme-toggle"
      type="button"
      aria-label="Переключить тему"
      class="shrink-0 text-muted hover:text-accent transition-colors cursor-pointer"
    >
      <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
      </svg>
      <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z" />
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', function () {
    var dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
</script>
