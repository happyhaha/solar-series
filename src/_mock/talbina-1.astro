---
const books = [
  { title: 'Атомные привычки', author: 'Джеймс Клир', last: 218, total: 384,
    cover: 'https://s.f.kz/prod/3353/3352469_1000.jpg' },
  { title: 'Поток', author: 'Михай Чиксентмихайи', last: 64, total: 320,
    cover: 'https://www.hse.ru/pubs/share/direct/792169181.jpg:r1118x745.jpg' },
  { title: 'Краткая история времени', author: 'Стивен Хокинг', last: 12, total: 256,
    cover: 'https://simg.marwin.kz/media/catalog/product/cache/41deb699a7fea062a8915debbbb0442c/c/o/cover1__w600_135_300.jpg' },
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>talbina — Читаю</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary: #894e58; --on-primary: #fff7f7; --primary-container: #feb2bd;
        --surface: #fcf9f7; --sc-lowest: #ffffff; --sc-low: #f6f3f1;
        --sc-high: #eae8e5; --on-surface: #323331; --on-surface-variant: #5f5f5d;
        --outline-variant: #b3b2af;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { background: var(--surface); }
      body { font-family: 'Inter', sans-serif; }
      .phone { width: 100vw; height: 100vh; background: var(--surface);
        color: var(--on-surface); position: relative; overflow: hidden; }
      .ms { font-family: 'Material Symbols Outlined'; font-weight: normal;
        font-style: normal; line-height: 1; display: inline-block; vertical-align: middle;
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
      .ms.fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

      .appbar { position: absolute; top: 0; left: 0; right: 0; height: 56px;
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 16px; background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 8px 24px rgba(50,51,49,.04); z-index: 50; }
      .appbar .logo { display: flex; align-items: center; gap: 8px; }
      .appbar .logo .ms { color: var(--primary); font-size: 24px; }
      .appbar .logo h1 { font-family: 'Montserrat', sans-serif; font-weight: 700;
        font-size: 20px; color: var(--primary); text-transform: lowercase;
        letter-spacing: -.02em; }
      .appbar .out { color: rgba(50,51,49,.6); font-size: 22px; }

      .main { position: absolute; top: 56px; bottom: 64px; left: 0; right: 0;
        overflow: hidden; padding: 24px 16px 0; }
      .h2 { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 24px;
        line-height: 1.15; margin-bottom: 24px; }

      .card { display: flex; align-items: center; gap: 12px; padding: 14px;
        background: var(--sc-lowest); border-radius: 12px;
        border: 1px solid rgba(179,178,175,.15); margin-bottom: 12px; }
      .cover { width: 40px; height: 56px; border-radius: 6px; flex-shrink: 0;
        overflow: hidden; background: var(--sc-high);
        box-shadow: 0 4px 10px -5px rgba(50,51,49,.5); }
      .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .info { flex: 1; min-width: 0; }
      .info .t { font-weight: 600; font-size: 14px; white-space: nowrap;
        overflow: hidden; text-overflow: ellipsis; }
      .info .a { font-size: 12px; color: var(--on-surface-variant); margin-top: 2px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .bar { height: 6px; background: var(--sc-high); border-radius: 99px;
        overflow: hidden; margin-top: 8px; }
      .bar i { display: block; height: 100%; background: var(--primary); border-radius: 99px; }
      .pages { font-size: 11px; color: var(--on-surface-variant); margin-top: 4px; }
      .play { width: 40px; height: 40px; border-radius: 999px; flex-shrink: 0;
        background: rgba(137,78,88,.1); display: grid; place-items: center; }
      .play .ms { color: var(--primary); font-size: 20px; }

      .add { width: 100%; display: flex; align-items: center; gap: 12px; padding: 14px;
        border-radius: 12px; border: 2px dashed rgba(179,178,175,.3);
        background: transparent; color: var(--on-surface-variant); font: inherit;
        font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 12px; }
      .add .ms { font-size: 20px; }

      .nav { position: absolute; bottom: 0; left: 0; right: 0; height: 64px;
        display: flex; justify-content: space-around; align-items: center;
        padding: 0 16px; background: rgba(252,249,247,.8); backdrop-filter: blur(12px);
        box-shadow: 0 -4px 24px rgba(50,51,49,.04); border-radius: 12px 12px 0 0; z-index: 50; }
      .nav a { display: flex; flex-direction: column; align-items: center;
        gap: 2px; padding: 4px 12px; border-radius: 12px;
        color: rgba(50,51,49,.5); text-decoration: none; }
      .nav a.on { background: rgba(254,178,189,.2); color: var(--primary); }
      .nav a .ms { font-size: 24px; }
      .nav a span { font-size: 10px; text-transform: uppercase; letter-spacing: .06em;
        margin-top: 2px; }
    </style>
  </head>
  <body>
    <div class="phone">
      <div class="appbar">
        <div class="logo">
          <span class="ms fill">spa</span>
          <h1>talbina</h1>
        </div>
        <span class="ms out">logout</span>
      </div>

      <div class="main">
        <h2 class="h2">Читаю</h2>

        {books.map((b) => (
          <div class="card">
            <div class="cover"><img src={b.cover} alt={b.title} /></div>
            <div class="info">
              <p class="t">{b.title}</p>
              <p class="a">{b.author}</p>
              <div class="bar"><i style={`width:${Math.round((b.last / b.total) * 100)}%`}></i></div>
              <p class="pages">{b.last} / {b.total} стр.</p>
            </div>
            <div class="play"><span class="ms fill">play_arrow</span></div>
          </div>
        ))}

        <button class="add">
          <span class="ms">add</span>
          <span>Добавить книгу</span>
        </button>
      </div>

      <nav class="nav">
        <a class="on"><span class="ms fill">auto_stories</span><span>Читаю</span></a>
        <a><span class="ms">library_books</span><span>Прочитано</span></a>
        <a><span class="ms">trending_up</span><span>Прогресс</span></a>
        <a><span class="ms">person</span><span>Профиль</span></a>
      </nav>
    </div>
  </body>
</html>
